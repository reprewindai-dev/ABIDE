# Inject this through the Coolify UI for the dedicated abide-postgres service.
# Internal form: postgres://abide_app:PASSWORD@abide-postgres:5432/abide?options=-c%20search_path%3Dabide
DATABASE_URL=""

# Real Cryptographic Payment Settlement:
