# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Custom integration base URL for OpenAI-compatible endpoints
AI_INTEGRATIONS_OPENAI_BASE_URL="http://localhost:1106/modelfarm/openai"
# Inject the real private Ollama endpoint through deployment configuration.
# Do not commit concrete infrastructure addresses.
OLLAMA_BASE_URL=""
OLLAMA_MODEL="llama3.2:latest"
OLLAMA_EMBED_MODEL="nomic-embed-text"
ABIDE_DEFAULT_PROVIDER="llama"
CAPI_URL="https://capi.veklom.com"
CAPI_REGISTRY_TOKEN=""
ABIDE_PUBLIC_BASE_URL="https://abide.veklom.com"
DISABLE_CAPI_REGISTRATION=""

# Veklom Plural Canonical Service Endpoints
VEKLOM_API_URL="https://api.veklom.com"
CAPPO_URL="https://cappo.veklom.com"
GNOMELEDGER_URL="https://pgl.veklom.com"
VNP_URL="https://vnp.veklom.com"

# Cryptographic signing keys (Milestone 1)
SEKED_HMAC_SECRET="SEKED_SYSTEM_COVENANT_SECRET"
CONSTITUTION_SIGNING_KEY="CONSTITUTION_GOVERNANCE_SECRET"
APPROVAL_TOKEN_SECRET="COVENANT_APPROVAL_TOKEN_SECRET_2026"

# =========================================================================
# REAL-WORLD CONNECTORS & API INTEGRATIONS (Pluggable Ingress/Egress Ports)
